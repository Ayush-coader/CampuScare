PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campuscare
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# Optional: only allow student sign-ups from this email domain (e.g. college.edu)
ALLOWED_EMAIL_DOMAIN=

# Auto-assign new complaints to the least-loaded staff member of that category
AUTO_ASSIGN=true
